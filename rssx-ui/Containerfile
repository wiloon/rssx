# ==========================================
# Build stage
# ==========================================
FROM node:18-alpine AS builder

WORKDIR /build

# Homelab CI passes the in-cluster Nexus npm group here; a bare build leaves it
# empty and keeps the public registry.
ARG NPM_REGISTRY=
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files (leverage layer cache).
# pnpm-workspace.yaml carries the build-script (onlyBuiltDependencies) decisions
# pnpm 10+ requires.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build production bundle
RUN pnpm run build

# ==========================================
# Runtime stage
# ==========================================
FROM nginx:1.23.3-alpine

COPY --from=builder /build/dist/ /usr/share/nginx/html/
COPY nginx-default.conf /etc/nginx/conf.d/default.conf
